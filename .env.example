# ─── Telegram Bot API (boshqaruv boti) ────────────────────────────────────────
BOT_TOKEN=123456:AA...
# Botning raqamli ID'si. PROTECTED_PEERS ga avtomatik qo'shiladi —
# agent hech qachon shu peer'ga yoza olmaydi.
CONTROL_BOT_ID=123456
# Faqat shu tg user_id'lar botdan foydalana oladi (vergul bilan)
ALLOWED_USER_IDS=

# ─── Telegram MTProto (my.telegram.org dan olinadi) ───────────────────────────
TG_API_ID=
TG_API_HASH=
# Login qilinadigan akkauntlarning device profili — O'ZGARTIRMANG,
# har login'da bir xil bo'lishi ban riskini kamaytiradi.
TG_DEVICE_MODEL=Desktop
TG_SYSTEM_VERSION=Windows 10
TG_APP_VERSION=5.7.1

# ─── Xavfsizlik ───────────────────────────────────────────────────────────────
# Master key: `python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"`
# Bu kalit yo'qolsa — barcha saqlangan session'lar tiklab bo'lmaydi.
MASTER_KEY_B64=
# Web UI / Mini App public URL. Prod'da HTTPS majburiy (login kodi shu orqali).
# Lokal: http://localhost:8080
WEBAPP_BASE_URL=https://example.com

# ─── Web UI ───────────────────────────────────────────────────────────────────
WEB_SESSION_TTL_HOURS=336        # cookie muddati (14 kun)
WEB_AUTH_FLOW_TTL_MIN=10         # telefon→kod→2FA oqimi qancha yashaydi
WEB_AUTH_RATE_PER_IP=5           # 10 daqiqada bir IP'dan nechta login boshlash
WEB_CONTEXT_DEFAULT_MESSAGES=50  # AI chatga default nechta oxirgi xabar beriladi
WEB_CONTEXT_MAX_MESSAGES=1000    # >200 faqat sinxronlangan (DB) chatlar uchun
WEB_AUTO_EVAL=true               # har javobdan keyin arzon model bilan auto-baho (fon)
WEB_AUTO_EVAL_SAMPLE=1.0         # baholanadigan javoblar ulushi (0.3 = har 3-chisi) — xarajat
AGENT_MAX_ITERATIONS=5           # agent (tool) sikli — LLM chaqiruvlar qopqog'i
AGENT_TOOL_RESULT_TOKENS=12000   # bitta savolda tool natijalari umumiy byudjeti
WRITE_PROPOSAL_TTL_HOURS=24      # tasdiqlanmagan taklif shuncha soatdan keyin eskiradi
WRITE_RATE_PER_HOUR=20           # akkaunt bo'yicha soatiga bajariladigan yozish amallari
EMBED_ENABLED=true               # vektor indeks (Gemini embedding, cron 15 daq)
EMBED_BATCH_PER_RUN=500

# ─── Ma'lumotlar bazasi ───────────────────────────────────────────────────────
POSTGRES_USER=tgai
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tgai
DATABASE_URL=postgresql+asyncpg://tgai:change_me@postgres:5432/tgai
REDIS_URL=redis://redis:6379/0

# ─── LLM: umumiy ──────────────────────────────────────────────────────────────
# Standart provider: auto | claude | claude_code | gemini | deepseek
# auto tartibi:
#   1) claude      — API kredensiali bor (ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN / profil)
#   2) claude_code — `claude` CLI o'rnatilgan va login qilingan (sessiyadan foydalanadi)
#   3) gemini      — hech biri yo'q
LLM_PROVIDER=auto
# Tanlangan provider vazifani bajara olmasa shu ishlatiladi.
# DeepSeek'da embedding ham, rasm generatsiya ham YO'Q — fallback Gemini bo'lsin.
LLM_FALLBACK_PROVIDER=gemini

# Vazifa darajasida bekor qilish: `provider:model` yoki faqat `provider`.
# Bo'sh = LLM_PROVIDER + o'sha providerning shu vazifa uchun standart modeli.
#   route  — intent klassifikatsiya (arzon)
#   search — qidiruv sintezi, rerank
#   tools  — agent tool-calling (function calling SHART)
#   deep   — chuqur tahlil
#   embed  — vektor indeks (faqat Gemini)
#   image  — rasm generatsiya (faqat Gemini)
# Provider sifatida `auto` ham yoziladi: LLM_TASK_DEEP=auto:claude-opus-5
LLM_TASK_ROUTE=
LLM_TASK_SEARCH=
LLM_TASK_TOOLS=
LLM_TASK_DEEP=
LLM_TASK_EMBED=
LLM_TASK_IMAGE=

# Misol — chuqur tahlilni DeepSeek reasoner'ga bering, qolgani Gemini'da:
#   LLM_TASK_DEEP=deepseek:deepseek-reasoner
# Misol — hamma chat DeepSeek'da, embedding/rasm avtomat Gemini'ga tushadi:
#   LLM_PROVIDER=deepseek

# ─── Claude / Anthropic ───────────────────────────────────────────────────────
# Kredensial ustuvorligi (birinchi topilgani ishlatiladi). Hech biri bo'lmasa
# `auto` rejimda Gemini ishlaydi. Claude'da embedding va rasm YO'Q —
# GEMINI_API_KEY baribir kerak.
#
# 1) Oddiy API kalit (console.anthropic.com):
ANTHROPIC_API_KEY=
# 2) Claude Code obunasi tokeni. Terminalda `claude setup-token` bajaring va
#    chiqqan `sk-ant-oat01-...` ni shu yerga qo'ying. Docker'da eng qulay yo'l.
CLAUDE_CODE_OAUTH_TOKEN=
# 3) Yoki `ant auth login` / Claude Code login profili diskda bo'lsa — hech
#    narsa yozmang, SDK ~/.config/anthropic dan o'zi topadi. Docker'da esa
#    docker-compose.yml dagi izohli volume'ni yoqing (ANTHROPIC_CONFIG_DIR).
# ANTHROPIC_AUTH_TOKEN=          # 2) ning umumiy nomi, xohlasangiz shu
# ANTHROPIC_BASE_URL=            # proxy/gateway bo'lsa
# ROUTER — arzon ishlar (intent, kunlik digest, auto-baho); FAST — chat/qidiruv/agent tool'lar;
# DEEP — "chuqur tahlil" tugmasi. Sifat kerak bo'lsa FAST=claude-opus-5.
CLAUDE_MODEL_ROUTER=claude-haiku-4-5
CLAUDE_MODEL_FAST=claude-sonnet-5
CLAUDE_MODEL_DEEP=claude-opus-5

# ─── Claude Code CLI (`claude_code` provider) ─────────────────────────────────
# `claude -p` subprocess: Claude Code'ning o'z login sessiyasi (Keychain / ~/.claude)
# ishlatiladi — hech qanday token yozish shart emas. Faqat `claude` CLI o'rnatilgan
# va `/login` qilingan mashinada (lokal / bare-metal). Docker'da CLI yo'q —
# u yerda CLAUDE_CODE_OAUTH_TOKEN ishlating.
# Cheklov: function calling YO'Q → Task.TOOLS avtomat fallback (Gemini) ga tushadi.
CLAUDE_CODE_AUTO=true          # false = auto rejimda CLI hisobga olinmaydi
CLAUDE_CODE_BIN=               # bo'sh = PATH'dan `claude`
CLAUDE_CODE_TIMEOUT=300        # soniya, bitta so'rov

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_ROUTER=gemini-2.5-flash-lite
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_MODEL_EMBED=gemini-embedding-001
EMBED_DIM=768

# ─── DeepSeek (OpenAI-mos API) ────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat          # function calling BOR
DEEPSEEK_MODEL_REASONER=deepseek-reasoner  # function calling YO'Q, kontekst 64K

# ─── Rejim ────────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
DEFAULT_LOCALE=uz
# Maksimal ulanadigan akkauntlar soni
MAX_ACCOUNTS=3
# Agent yozish rejimi: read_only | write_with_confirm | autonomous
DEFAULT_WRITE_MODE=write_with_confirm
